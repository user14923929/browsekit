/* browsekit — default light theme */

QMainWindow, QWidget {
    background-color: #f5f5f5;
    color: #1a1a1a;
}

QTabWidget::pane {
    border: none;
    background-color: #f5f5f5;
}

QTabBar::tab {
    background-color: #e0e0e0;
    color: #555;
    padding: 6px 16px;
    border: none;
    border-right: 1px solid #ccc;
    font-size: 13px;
    min-width: 80px;
    max-width: 200px;
}

QTabBar::tab:selected {
    background-color: #f5f5f5;
    color: #1a1a1a;
    border-bottom: 2px solid #1a73e8;
}

QTabBar::tab:hover:!selected {
    background-color: #d5d5d5;
}

QLineEdit {
    background-color: #fff;
    color: #1a1a1a;
    border: 1px solid #ccc;
    border-radius: 6px;
    padding: 5px 10px;
    font-size: 13px;
    selection-background-color: #1a73e8;
    selection-color: #fff;
}

QLineEdit:focus {
    border-color: #1a73e8;
}

QPushButton {
    background-color: #fff;
    color: #1a1a1a;
    border: 1px solid #ccc;
    border-radius: 5px;
    padding: 5px 12px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #f0f0f0;
    border-color: #aaa;
}

QPushButton:pressed {
    background-color: #e5e5e5;
}

QToolBar {
    background-color: #ececec;
    border-bottom: 1px solid #d0d0d0;
    spacing: 4px;
    padding: 4px 6px;
}

QStatusBar {
    background-color: #ececec;
    color: #888;
    font-size: 11px;
    border-top: 1px solid #d0d0d0;
}

QScrollBar:vertical {
    background: #f5f5f5;
    width: 8px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #bbb;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #999;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}
